{
    "name": "hu-kit",
    "version": "1.8.3",
    "description": "Sistema de diseño de los sistemas del Hospital Universitario: preset de Tailwind, estilos base, fuentes y componentes de React.",
    "license": "UNLICENSED",
    "private": true,
    "type": "module",
    "files": [
        "estilos/",
        "componentes/"
    ],
    "exports": {
        "./tailwind": "./estilos/tailwind.js",
        "./tokens": "./estilos/tokens.js",
        "./estilos.css": "./estilos/estilos.css",
        "./componentes": "./componentes/index.js"
    },
    "scripts": {
        "catalogo": "vite --config catalogo/vite.config.js",
