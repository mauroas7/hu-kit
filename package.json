        "@headlessui/react": "^2.2.10",
        "@inertiajs/react": "^2.0.0",
        "react": "^18.3.1",
        "react-day-picker": "^9.14.0",
        "tailwindcss": "^3.4.0"
    },
    "devDependencies": {
        "@headlessui/react": "2.2.10",
        "@inertiajs/react": "2.3.29",
        "@vitejs/plugin-react": "4.7.0",
        "autoprefixer": "10.4.21",
        "postcss": "8.5.6",
        "react": "18.3.1",
        "react-day-picker": "9.14.0",
        "react-dom": "18.3.1",
        "tailwindcss": "3.4.19",
        "vite": "7.3.7"
